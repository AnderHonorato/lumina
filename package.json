{
  "name": "lumina-notes",
  "version": "1.0.0",
  "description": "Lumina - Aplicativo de anotações, diário e lembretes",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "pack": "electron-builder --dir",
    "postinstall": "electron-builder install-app-deps"
  },
  "keywords": ["notes", "diary", "reminders", "calendar", "electron"],
  "author": "Lumina",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "bcryptjs": "^2.4.3",
    "uuid": "^9.0.0",
    "node-cron": "^3.0.3",
    "node-notifier": "^10.0.1",
    "archiver": "^6.0.1",
    "extract-zip": "^2.0.1"
  },
  "build": {
    "appId": "com.lumina.notes",
    "productName": "Lumina Notes",
    "copyright": "Copyright © 2024 Lumina",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "src/renderer/assets/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "installerIcon": "src/renderer/assets/icon.ico",
      "uninstallerIcon": "src/renderer/assets/icon.ico",
      "installerHeaderIcon": "src/renderer/assets/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lumina Notes",
      "runAfterFinish": true,
      "installerLanguages": ["pt_BR"],
      "language": "1046"
    },
    "files": [
      "src/**/*",
      "node_modules/**/*",
      "!node_modules/.cache"
    ],
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "src/renderer/assets",
        "to": "assets"
      }
    ]
  }
}
