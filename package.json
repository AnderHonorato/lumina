{
  "name": "lumina-notes",
  "version": "2.0.0-beta.1",
  "description": "Lumina Notes - anotações, diário, lembretes, calendário e organização pessoal offline-first",
  "main": "src/main/bootstrap.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "pack": "electron-builder --dir",
    "postinstall": "electron-builder install-app-deps",
    "android:add": "npx cap add android",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "android:doctor": "npx cap doctor"
  },
  "keywords": ["notes", "diary", "reminders", "calendar", "electron", "capacitor", "android", "offline-first"],
  "author": "Lumina",
  "license": "MIT",
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/camera": "^8.0.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/geolocation": "^8.0.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor-community/sqlite": "^8.1.1",
    "capacitor-secure-storage-plugin": "^0.13.0",
    "archiver": "^6.0.1",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.10.0",
    "extract-zip": "^2.0.1",
    "node-cron": "^3.0.3",
    "node-notifier": "^10.0.1",
    "uuid": "^9.0.0"
  },
  "build": {
    "appId": "com.lumina.notes",
    "productName": "Lumina Notes",
    "copyright": "Copyright © 2026 Lumina",
    "win": {
      "target": [{"target": "nsis", "arch": ["x64"]}],
      "icon": "src/renderer/assets/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "installerIcon": "src/renderer/assets/icon.ico",
      "uninstallerIcon": "src/renderer/assets/icon.ico",
      "installerHeaderIcon": "src/renderer/assets/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lumina Notes",
      "runAfterFinish": true,
      "installerLanguages": ["pt_BR"],
      "language": "1046"
    },
    "files": ["src/**/*", "node_modules/**/*", "!node_modules/.cache"],
    "directories": {"output": "dist"},
    "extraResources": [{"from": "src/renderer/assets", "to": "assets"}]
  }
}
